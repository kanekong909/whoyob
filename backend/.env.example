# Copia este archivo a .env y llena los valores

# Base de datos MySQL (Railway te da estos valores)
DB_HOST=containers-us-west-XXX.railway.app
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_password_aqui
DB_NAME=worknotes

# JWT - pon cualquier string largo y secreto
JWT_SECRET=cambia_esto_por_algo_muy_secreto_123456

# Puerto del servidor
PORT=3000

# URL del frontend (para CORS)
# En desarrollo: http://localhost:5500
# En producción: https://tu-usuario.github.io
FRONTEND_URL=http://localhost:5500

# Carpeta donde se guardan las fotos subidas
UPLOADS_DIR=uploads
